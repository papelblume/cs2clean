{
  "name": "cs2clean",
  "productName": "CS2Clean",
  "private": true,
  "version": "0.2.0",
  "description": "CS2Clean companion app and in-game overlay for CS2. Shows the evidence class of the players in your match.",
  "author": "CS2Clean",
  "homepage": "https://github.com/papelblume/cs2clean",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc --noEmit -p tsconfig.json && vite build",
    "start": "npm run build && electron .",
    "start:replay": "npm run build && electron . --replay",
    "start:overwolf": "npm run build && ow-electron . --overwolf",
    "coplay": "tsc -p tsconfig.main.json && node dist/main/steam/coplay-cli.js",
    "leetify:probe": "tsc -p tsconfig.main.json && node dist/main/leetify-cli.js",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "check:package": "electron-builder --linux dir --x64 && node tools/check-package.mjs release/linux-unpacked/resources/app.asar",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "overwolf": {
    "packages": [
      "gep",
      "overlay"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@overwolf/ow-electron": "^42.7.1",
    "@overwolf/ow-electron-packages-types": "^1.1.11",
    "@types/node": "^24.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@ulixee/hero-playground": "^2.0.0-alpha.34",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.2.1",
    "electron-builder": "^26.15.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "koffi": "^2.16.3"
  },
  "build": {
    "appId": "eu.cs2clean.companion",
    "productName": "CS2Clean",
    "copyright": "CS2Clean",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json",
      "!**/*.map",
      "!dist/main/steam/coplay-cli.js",
      "!dist/main/leetify-cli.js",
      "!dist/main/leetify-hero-cli.js",
      "!node_modules/koffi/build/koffi/!(win32_x64|linux_x64)/**",
      "!node_modules/koffi/{src,doc,vendor}/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CS2Clean",
      "runAfterFinish": true,
      "artifactName": "CS2Clean-Setup-${version}.${ext}"
    },
    "publish": null,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "description": "CS2Clean companion app and in-game overlay for CS2",
      "icon": "assets/icon.png"
    }
  }
}
